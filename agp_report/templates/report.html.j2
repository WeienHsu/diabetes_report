<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<title>血糖回診報告 {{ m.start.strftime('%Y-%m-%d') }} ~ {{ m.end.strftime('%Y-%m-%d') }}</title>
<style>
  /* 中文字型依序退回：桌機常見的思源／蘋方／微軟正黑，Pi 上則落在文泉驛 */
  :root {
    --surface: #fcfcfb; --plane: #f9f9f7;
    --ink: #0b0b0b; --ink2: #52514e; --muted: #898781;
    --grid: #e1e0d9; --axis: #c3c2b7;
    --good: #0ca30c; --warn: #fab219; --crit: #d03b3b;
  }
  @page { size: A4; margin: 11mm; }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--plane); color: var(--ink);
    font-family: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei",
                 "WenQuanYi Zen Hei", system-ui, sans-serif;
    font-size: 12px; line-height: 1.5; text-wrap: pretty;
  }
  a, a:hover { color: var(--ink2); }
  .page {
    width: 188mm; min-height: 275mm; margin: 0 auto 8mm; padding: 0 0 6mm;
    background: var(--surface);
  }
  /* 餐食頁的卡片數會隨飲食紀錄增加，本來就該自然跨頁；固定成一頁反而會擠爆。
     只要求卡片本身不被切斷，區段標題不落在頁尾。 */
  .page.flow { min-height: 0; }

  /* 窄螢幕替代版面，預設不顯示；桌機與列印都走原本的表格 */
  .blocks-list { display: none; }

  /* 互動層。預設完全不顯示——沒有 JS 時就是一張靜態 SVG，與改動前無異。 */
  .xh-tip {
    position: absolute; pointer-events: none; z-index: 5; opacity: 0;
    background: #fff; color: var(--ink); border: 1px solid var(--ink);
    font-size: 10px; line-height: 1.45; padding: 4px 7px;
    white-space: nowrap; font-variant-numeric: tabular-nums;
  }
  .xh-tip b { font-size: 12px; }
  .xh-tip .ev { color: var(--ink2); }
  .xh-wrap { position: relative; }

  /* 折疊。用原生 details/summary——鍵盤操作與無障礙都是免費的，不需要 JS。
     列印時一律展開：下載的 PDF 由伺服器端從儲存檔轉出，那份永遠是 open；
     使用者自己 Ctrl+P 的情況由頁尾的 beforeprint 補上。 */
  .sect { border: 0; }
  .sect > summary {
    list-style: none; cursor: pointer; position: relative;
  }
  .sect > summary::-webkit-details-marker { display: none; }
  .sect > summary header { margin-bottom: 12px; }
  .sect > summary .toggle {
    position: absolute; right: 0; top: 2px; width: 9px; height: 9px;
    border-right: 1.5px solid var(--ink2); border-bottom: 1.5px solid var(--ink2);
    transform: rotate(45deg); transition: transform .12s;
  }
  .sect[open] > summary .toggle { transform: rotate(-135deg); top: 6px; }
  .sect:not([open]) > summary header { border-bottom-color: var(--grid); }
  @media screen {
    .sect > summary:hover header h1 { text-decoration: underline; }
    .sect > summary:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  }
  @media print {
    .sect > summary { list-style: none; }
    .sect > summary .toggle { display: none; }
  }

  /* ── 列印：A4 行為完全維持原樣，本區塊是這份報告的原始設計 ──────────── */
  @media print {
    body { background: #fff; }
    .page { margin: 0; width: auto; min-height: 0; page-break-after: always; }
    .page:last-child { page-break-after: auto; }
    .card { page-break-inside: avoid; break-inside: avoid; }
    tr { page-break-inside: avoid; break-inside: avoid; }
    thead { display: table-header-group; }
    h2, h3 { page-break-after: avoid; break-after: avoid; }
    .toolbar { display: none; }
    /* 互動元件一律不進紙本。PDF 由 headless chromium 吃同一份檔案轉出，
       它會執行這段 JS，但列印時看不到任何互動痕跡。 */
    .xh-tip, .xh-cross, .xh-dot { display: none !important; }
  }

  /* ── 螢幕：同一份 HTML 的另一套版面。捲動順序與紙本完全一致 ────────── */
  @media screen {
    .toolbar {
      position: sticky; top: 0; z-index: 10;
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 9px 16px; background: var(--surface);
      border-bottom: 1px solid var(--ink); margin-bottom: 8mm;
    }
    .toolbar .meta { font-size: 10.5px; color: var(--ink2); }
    .toolbar .meta b { font-size: 12px; }
    .toolbar .acts { display: flex; gap: 8px; flex: none; }
    .toolbar a {
      font-size: 11px; font-weight: 600; padding: 6px 12px; text-decoration: none;
      background: var(--ink); color: #fff; border: 1px solid var(--ink);
    }
    .toolbar a.ghost { background: transparent; color: var(--ink); border-color: var(--axis); }
    .toolbar a:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  }

  .brow {
    display: flex; align-items: baseline; gap: 10px;
    border-bottom: 1px solid var(--grid); padding: 5px 0;
  }
  .brow .t { font-size: 10px; color: var(--muted); width: 42px; flex: none;
             font-variant-numeric: tabular-nums; }
  .brow .m { font-size: 15px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .brow .r { font-size: 9.5px; color: var(--ink2); margin-left: auto;
             font-variant-numeric: tabular-nums; }

  h1 { font-size: 17px; margin: 0; letter-spacing: -0.2px; }
  h2 { font-size: 13px; margin: 0 0 6px; letter-spacing: 0.02em; }
  h3 { font-size: 11px; margin: 0 0 4px; color: var(--ink2); font-weight: 600; }
  .sub { color: var(--ink2); font-size: 11px; }
  .muted { color: var(--muted); }
  .tnum { font-variant-numeric: tabular-nums; }

  header {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 16px; padding-bottom: 8px; border-bottom: 1.5px solid var(--ink);
    margin-bottom: 12px;
  }
  section { margin-bottom: 14px; }
  .rule { border-top: 1px solid var(--grid); padding-top: 10px; }

  .cols { display: grid; grid-template-columns: 1fr auto; gap: 20px; align-items: start; }
  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px 14px; }
  .stat { border-top: 2px solid var(--ink); padding-top: 5px; }
  .stat .k { font-size: 10px; color: var(--ink2); }
  .stat .v { font-size: 22px; font-weight: 600; line-height: 1.15; }
  .stat .g { font-size: 9.5px; color: var(--muted); }
  .hit { color: var(--good); font-weight: 600; }
  .miss { color: var(--crit); font-weight: 600; }

  table { border-collapse: collapse; width: 100%; font-size: 10.5px; }
  th, td { text-align: left; padding: 3px 6px; border-bottom: 1px solid var(--grid); }
  th { color: var(--ink2); font-weight: 600; }
  td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; }
  .swatch { display: inline-block; width: 9px; height: 9px; margin-right: 5px;
            vertical-align: -1px; }

  /* 時段表：12 欄擠在 188mm 內，每欄約 54px，字級必須壓到 9px 才排得下 */
  .blocks { border-collapse: collapse; width: 100%; font-size: 9px; table-layout: fixed; }
  .blocks th, .blocks td { text-align: center; padding: 3px 1px;
                           border-bottom: 1px solid var(--grid);
                           font-variant-numeric: tabular-nums; }
  .blocks th.lbl, .blocks td.lbl { text-align: left; width: 70px; color: var(--ink2);
                                   font-size: 9.5px; padding-left: 0; }
  .blocks thead th { color: var(--muted); font-weight: 600; font-size: 8.5px; }
  .blocks tr.avg td { font-weight: 600; font-size: 11px; }
  .blocks .worst { outline: 1.5px solid var(--ink); outline-offset: -1.5px; }

  /* 每日詳圖。表格第一欄寬度必須等於 charts.DETAIL_LABEL_W，
     欄位才會與上方曲線的時間軸對齊。 */
  .day { margin-bottom: 13px; }
  .dhead { font-size: 11px; margin-bottom: 1px; }
  .dhead .dmeta { float: right; font-size: 9.5px; color: var(--muted); }
  .ht { border-collapse: collapse; width: 100%; table-layout: fixed;
        font-size: 7.5px; font-variant-numeric: tabular-nums; margin-top: 1px; }
  .ht th, .ht td { text-align: center; padding: 1px 0; border-bottom: 1px solid var(--grid); }
  .ht th.lbl { width: 78px; text-align: left; font-size: 8px; color: var(--ink2);
               font-weight: 400; padding-left: 0; }
  .ht thead th { color: var(--muted); font-size: 7px; border-bottom: 0; }
  .ht thead th.anchor { color: var(--ink2); font-weight: 700; }
  .ht tr.ins td { color: #8e2b6b; }
  .ht tr.carb td { color: #2a78d6; }
  .ht td.hi250 { background: #fbe6dd; }
  .ht td.lo70 { background: #fae3e3; font-weight: 600; }
  .legend { display: flex; flex-wrap: wrap; gap: 12px; font-size: 9px;
            color: var(--ink2); margin-top: 4px; }
  .legend i { display: inline-block; width: 9px; height: 9px; margin-right: 4px;
              vertical-align: -1px; }
  .legend i.ring { background: #fff; border: 1px solid #2a78d6; border-radius: 50%; }
  .legend i.diamond { background: #2a78d6; transform: rotate(45deg); width: 7px; height: 7px; }

  .meals { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .card { border: 1px solid var(--grid); padding: 8px 9px; background: #fff; }
  .card .when { font-size: 10px; color: var(--muted); }
  .card .name { font-size: 11.5px; font-weight: 600; margin: 1px 0 4px;
                overflow-wrap: anywhere; }
  .macros { display: flex; gap: 8px; font-size: 10px; color: var(--ink2);
            margin-bottom: 4px; }
  .macros b { font-weight: 600; color: var(--ink); }
  .verdict { font-size: 10.5px; margin-top: 4px; }
  .thin { border-left: 3px solid var(--warn); padding-left: 7px;
          font-size: 10.5px; color: var(--ink2); }

  footer { margin-top: 14px; padding-top: 8px; border-top: 1px solid var(--grid);
           font-size: 9.5px; color: var(--muted); }

  /* ── 窄螢幕覆寫必須放在所有元件規則之後 ────────────────────────────────
     媒體查詢不增加優先權，同權重下由順序決定。寫在前面的話，
     .cols 與 .meals 的 grid-template-columns 會被後面的基礎規則蓋回去。 */

  /* SVG 都已內含 viewBox，縮放純粹是 CSS 的事——charts.py 不需要任何改動 */
  @media screen and (max-width: 860px) {
    .page { width: auto; max-width: 100%; min-height: 0; padding: 0 12px 6mm; }
    svg { max-width: 100%; height: auto; }
    .cols { grid-template-columns: 1fr; }
    .meals { grid-template-columns: 1fr; }
    .toolbar { margin-bottom: 4mm; }
  }

  /* 12 欄的時段表在手機上必然不可讀，改用依平均值排序的列式；
     完整的 12 欄仍保留在列印版，等價檢視不因螢幕縮減而失效 */
  @media screen and (max-width: 600px) {
    .blocks { display: none; }
    .blocks-list { display: block; }
    .drop-narrow { display: none; }
    .toolbar { flex-wrap: wrap; }
    header { flex-wrap: wrap; gap: 6px; }
  }
</style>
</head>
<body>

{# 只有 web 層會傳 toolbar；CLI 產出的檔案沒有這一段。列印時一律隱藏，
   所以同一份 HTML 既是線上頁面、也是轉 PDF 的來源。 #}
{% if toolbar %}
<div class="toolbar">
  <div class="meta tnum">
    <b>{{ m.start.strftime('%Y-%m-%d') }} – {{ m.end.strftime('%Y-%m-%d') }}</b>　{{ m.days }} 天　·　涵蓋率 {{ '%.0f'|format(m.coverage_pct) }}%　·　TIR <b>{{ '%.1f'|format(m.band_pct['target']) }}%</b>
  </div>
  <div class="acts">
    <a class="ghost" href="{{ toolbar.new }}">新報告</a>
    <a href="{{ toolbar.pdf }}">下載 PDF</a>
  </div>
</div>
{% endif %}

{# ── P1 醫師版 AGP：完全遵循國際共識版面，讓醫師秒讀 ───────────────── #}
<div class="page">
  <header>
    <div>
      <h1>血糖回診報告 · AGP</h1>
      <div class="sub">{{ patient }}</div>
    </div>
    <div class="sub tnum" style="text-align:right">
      {{ m.start.strftime('%Y-%m-%d') }} – {{ m.end.strftime('%Y-%m-%d') }}（{{ m.days }} 天）<br>
      感測器涵蓋率 {{ '%.0f'|format(m.coverage_pct) }}%・{{ m.readings }} 筆讀數
    </div>
  </header>

  <section class="cols">
    <div>
      <h2>血糖統計</h2>
      <div class="stats">
        <div class="stat">
          <div class="k">平均葡萄糖</div>
          <div class="v tnum">{{ '%.0f'|format(m.mean) }}<span style="font-size:11px"> mg/dL</span></div>
        </div>
        <div class="stat">
          <div class="k">葡萄糖管理指標 GMI</div>
          <div class="v tnum">{{ '%.1f'|format(m.gmi_pct) }}%</div>
          <div class="g">目標 &lt;7.0%　<span class="{{ 'hit' if m.gmi_pct < 7 else 'miss' }}">{{ '達標' if m.gmi_pct < 7 else '未達標' }}</span></div>
        </div>
        <div class="stat">
          <div class="k">血糖變異度 CV</div>
          <div class="v tnum">{{ '%.1f'|format(m.cv_pct) }}%</div>
          <div class="g">目標 ≤36%　<span class="{{ 'hit' if m.cv_pct <= 36 else 'miss' }}">{{ '達標' if m.cv_pct <= 36 else '未達標' }}</span></div>
        </div>
        {# SD = CV × 平均，三者同時顯示時 SD 不帶獨立資訊。這一格改放低血糖事件——
           一個達標的 TBR 百分比可能藏著睡夢中一小時的低血糖。 #}
        <div class="stat">
          <div class="k">低血糖事件</div>
          <div class="v tnum">{{ events|length }}<span style="font-size:11px"> 次</span></div>
          <div class="g">
            {%- if events %}平均持續 {{ (events|sum(attribute='minutes') / events|length)|round|int }} 分・最低 {{ '%.0f'|format(events|map(attribute='nadir')|min) }}
            {%- else %}期間內無連續 15 分鐘以上的低血糖{% endif %}
          </div>
        </div>
      </div>

      {# 堆疊條的紅綠在色盲下不可分，這張表是等價的無障礙檢視，不是補充資料。
         擺在統計數字下方而非獨立段落，是為了填滿堆疊條旁的縱向空間。 #}
      <h3 style="margin-top:12px">各分區時間佔比</h3>
      <table>
        <thead><tr>
          <th>分區</th><th class="n">佔比</th><th class="n drop-narrow">每日約</th>
          <th class="n">判定值</th><th class="n">國際目標</th><th>達標</th>
        </tr></thead>
        <tbody>
        {% for row in band_rows %}
          <tr>
            <td><span class="swatch" style="background:{{ row.color }}"></span>{{ row.label }}</td>
            <td class="n">{{ '%.1f'|format(row.pct) }}%</td>
            <td class="n muted drop-narrow">{{ row.hhmm }}</td>
            <td class="n">{% if row.combined is not none %}<b>{{ '%.1f'|format(row.combined) }}%</b>{% else %}<span class="muted">—</span>{% endif %}</td>
            <td class="n muted">{{ row.goal }}%</td>
            <td class="{{ 'hit' if row.ok else 'miss' }}">{{ '✓' if row.ok else '✗' }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      <div class="sub" style="font-size:9.5px;margin-top:3px">
        判定值為達標實際比較的累計分區——「低」比的是 &lt;70 全體、「高」比的是 &gt;180 全體。
        其餘各列的判定值即左方佔比。
      </div>
    </div>
    <div style="text-align:center">
      <h2>時間佔比</h2>
      {{ tir_svg|safe }}
    </div>
  </section>

  <section class="rule">
    <h2>24 小時血糖分佈（AGP）</h2>
    <div class="sub" style="margin-bottom:2px">
      深線為中位數，深帶 25–75%，淺帶 5–95%；綠底為目標範圍 70–180 mg/dL
    </div>
    <div class="xh-wrap">{{ agp_svg|safe }}</div>
  </section>

  <section class="rule">
    <h2>每日血糖曲線</h2>
    {% if daily_note %}<div class="sub" style="margin-bottom:2px">{{ daily_note }}</div>{% endif %}
    {{ daily_svg|safe }}
  </section>

  <footer>
    本報告由個人血糖與飲食紀錄自動彙整，僅呈現資料型態，<strong>不構成任何胰島素劑量或用藥建議</strong>。
    請與您的醫療團隊一同判讀。GMI 為依平均葡萄糖推估之糖化血色素指標，與實驗室 HbA1c 可能有落差。
  </footer>
</div>

{# ── P2 時段與每日模式：把 AGP 的形狀翻譯成「哪個時段、哪一天」 ──────────
   低血糖事件數會隨期間成長（14 天 3 次、90 天 22 次），與餐食卡片同一個性質，
   因此同樣不鎖定頁數。截斷一份臨床安全清單比多印一頁糟得多。 #}
<div class="page flow"><details class="sect" open><summary><header>
    <div>
      <h1>時段與每日模式</h1>
      <div class="sub">找出問題集中在一天中的哪個時段、哪一天</div>
    </div>
    <div class="sub tnum" style="text-align:right">
      {{ m.start.strftime('%Y-%m-%d') }} – {{ m.end.strftime('%Y-%m-%d') }}（{{ m.days }} 天）<br>
      低血糖事件 {{ events|length }} 次
    </div>
  </header><span class="toggle" aria-hidden="true"></span></summary><div class="sect-body">

  <section>
    <h2>每 2 小時時段統計</h2>
    <div class="sub" style="margin-bottom:3px">
      平均值依所屬分區上淡色底；框線為本期間平均值最高的時段
    </div>
    <table class="blocks">
      <thead>
        <tr>
          <th class="lbl"></th>
          {% for b in blocks %}<th>{{ b.label }}</th>{% endfor %}
        </tr>
      </thead>
      <tbody>
        <tr class="avg">
          <td class="lbl">平均 mg/dL</td>
          {% for b in blocks %}
          <td class="{{ 'worst' if b.hour == worst_block.hour }}"
              style="background:{{ band_tint[b.band] }}">{{ '%.0f'|format(b.mean) }}</td>
          {% endfor %}
        </tr>
        <tr>
          <td class="lbl">目標內 TIR</td>
          {% for b in blocks %}
          <td class="{{ 'worst' if b.hour == worst_block.hour }}">{{ '%.0f'|format(b.tir_pct) }}%</td>
          {% endfor %}
        </tr>
        <tr>
          <td class="lbl">&gt;250 佔比</td>
          {% for b in blocks %}
          <td class="{{ 'worst' if b.hour == worst_block.hour }}">{{ '%.0f'|format(b.very_high_pct) }}%</td>
          {% endfor %}
        </tr>
        <tr>
          <td class="lbl">速效 u/日</td>
          {% for b in blocks %}
          <td class="{{ 'worst' if b.hour == worst_block.hour }}">
            {%- if b.insulin_per_day %}{{ '%.1f'|format(b.insulin_per_day) }}{% else %}<span class="muted">—</span>{% endif -%}
          </td>
          {% endfor %}
        </tr>
        {% if blocks|sum(attribute='meals') %}
        <tr>
          <td class="lbl">餐次・碳水</td>
          {% for b in blocks %}
          <td class="{{ 'worst' if b.hour == worst_block.hour }}">
            {%- if b.meals %}{{ b.meals }}・{{ '%.0f'|format(b.carbs_mean) }}g{% else %}<span class="muted">—</span>{% endif -%}
          </td>
          {% endfor %}
        </tr>
        {% endif %}
      </tbody>
    </table>

    {# 手機版：同一批數字改依平均值由高到低排，「哪個時段最糟」正是這頁的目的 #}
    <div class="blocks-list">
      {% for b in blocks_ranked %}
      <div class="brow" style="background:{{ band_tint[b.band] }}">
        <span class="t">{{ b.label }}</span>
        <span class="m">{{ '%.0f'|format(b.mean) }}</span>
        <span class="r">TIR {{ '%.0f'|format(b.tir_pct) }}%　&gt;250 {{ '%.0f'|format(b.very_high_pct) }}%　速效 {{ '%.1f'|format(b.insulin_per_day) }}u</span>
      </div>
      {% endfor %}
    </div>

    <div class="sub" style="margin-top:5px">
      本期間平均值最高的是 <b>{{ worst_block.label }} 時</b>：平均 {{ '%.0f'|format(worst_block.mean) }} mg/dL、
      目標內僅 {{ '%.0f'|format(worst_block.tir_pct) }}%、{{ '%.0f'|format(worst_block.very_high_pct) }}% 的時間超過 250。
      該時段速效胰島素平均 {{ '%.1f'|format(worst_block.insulin_per_day) }} u/日。
    </div>
  </section>

  {% if events %}
  <section class="rule">
    <h2>低血糖事件</h2>
    <div class="sub" style="margin-bottom:3px">
      依國際共識定義：連續 15 分鐘以上低於 70 mg/dL 為一次事件
    </div>
    <table>
      <thead><tr>
        <th>開始</th><th class="n">持續</th><th class="n">最低</th>
        <th class="n">前 4 小時速效</th><th>時段</th>
      </tr></thead>
      <tbody>
      {% for e in events %}
        <tr>
          <td class="tnum">{{ e.start.strftime('%m-%d %H:%M') }}</td>
          <td class="n tnum">{{ e.minutes }} 分</td>
          <td class="n tnum">{{ '%.0f'|format(e.nadir) }}</td>
          <td class="n tnum">{% if e.bolus_before %}{{ '%.1f'|format(e.bolus_before) }} u{% else %}<span class="muted">—</span>{% endif %}</td>
          <td>{{ e.period }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  <section class="rule">
    <h2>每日摘要</h2>
    {% if days_note %}<div class="sub" style="margin-bottom:3px">{{ days_note }}</div>{% endif %}
    <table>
      <thead><tr>
        <th>日期</th><th>週</th><th class="n">平均</th><th class="n">TIR</th>
        <th class="n">最高</th><th class="n">最低</th><th class="n">速效 u</th><th class="n">低血糖</th>
      </tr></thead>
      <tbody>
      {% for r in days_rows %}
        <tr{% if r.partial %} class="muted"{% endif %}>
          <td class="tnum">{{ r.day.strftime('%m-%d') }}{% if r.partial %}<span title="期間頭尾，非完整一日">*</span>{% endif %}</td>
          <td>{{ r.weekday }}</td>
          <td class="n tnum">{{ '%.0f'|format(r.mean) }}</td>
          <td class="n tnum">{{ '%.0f'|format(r.tir_pct) }}%</td>
          <td class="n tnum">{{ '%.0f'|format(r.highest) }}</td>
          <td class="n tnum">{{ '%.0f'|format(r.lowest) }}</td>
          <td class="n tnum">{{ '%.1f'|format(r.insulin_units) }}</td>
          <td class="n tnum">{% if r.hypo_count %}<span class="miss">{{ r.hypo_count }}</span>{% else %}<span class="muted">—</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <footer>
    時段統計的形狀會隨期間長度明顯變化，短期間波動大，<strong>不宜當成穩定結論</strong>。
    標示 <b>*</b> 的日期位於期間頭尾、只涵蓋部分時間，各欄數值不可與整日相比。
    其餘日期的速效胰島素欄反映的是<strong>記錄</strong>而非實際注射量，數值明顯偏低通常代表當天漏記。
    本報告只呈現資料型態，不構成任何胰島素劑量或用藥建議。
  </footer>
</div></details></div>

{# ── P3 每日詳圖：每日縮圖看不出的敘事——幾點打了幾單位、之後血糖怎麼走。
   單日區塊約 158px，A4 一頁裝 5 天，7 天自然跨成 2 頁。 #}
{% if details %}
<div class="page flow"><details class="sect" open><summary><header>
    <div>
      <h1>每日詳細記錄</h1>
      <div class="sub">每日完整曲線、注射時刻與每小時極值</div>
    </div>
    <div class="sub tnum" style="text-align:right">
      {{ details[0][0].day.strftime('%Y-%m-%d') }} – {{ details[-1][0].day.strftime('%Y-%m-%d') }}<br>
      僅列最近 {{ detail_days }} 天{% if detail_short %}<br><span class="miss">{{ detail_short }}</span>{% endif %}
    </div>
  </header><span class="toggle" aria-hidden="true"></span></summary><div class="sect-body">

  {% for d, svg in details %}
  <section class="day">
    <div class="dhead">
      <b class="tnum">{{ d.day.strftime('%m-%d') }}</b>　週{{ d.weekday }}
      <span class="dmeta tnum">TIR {{ '%.0f'|format(d.tir_pct) }}%　讀數 {{ d.readings }}／96　注射 {{ '%.0f'|format(d.units) }}u</span>
    </div>
    <div class="xh-wrap">{{ svg|safe }}</div>
    {% set by_hour = d.insulin_by_hour() %}
    <table class="ht">
      <thead><tr>
        <th class="lbl"></th>
        {% for h in range(24) %}<th class="{{ 'anchor' if h in (6, 12, 18) }}">{{ '%02d'|format(h) if h % 2 == 0 else '' }}</th>{% endfor %}
      </tr></thead>
      <tbody>
        <tr>
          <th class="lbl">最高 mg/dL</th>
          {% for cell in d.hourly %}
          <td class="{{ 'hi250' if cell and cell[0] >= 250 }}">{{ '%.0f'|format(cell[0]) if cell }}</td>
          {% endfor %}
        </tr>
        <tr>
          <th class="lbl">最低 mg/dL</th>
          {% for cell in d.hourly %}
          <td class="{{ 'lo70' if cell and cell[1] < 70 }}">{{ '%.0f'|format(cell[1]) if cell }}</td>
          {% endfor %}
        </tr>
        <tr class="ins">
          <th class="lbl">速效 u</th>
          {% for h in range(24) %}
          <td>{% if by_hour.get(h) %}<b>{{ '%.1f'|format(by_hour[h]) }}</b>{% endif %}</td>
          {% endfor %}
        </tr>
        {% set carbs = d.carbs_by_hour() %}
        {% if carbs %}
        <tr class="carb">
          <th class="lbl">碳水 g</th>
          {% for h in range(24) %}
          <td>{% if carbs.get(h) %}<b>{{ '%.0f'|format(carbs[h]) }}</b>{% endif %}</td>
          {% endfor %}
        </tr>
        {% endif %}
      </tbody>
    </table>
  </section>
  {% endfor %}

  <div class="legend">
    <span><i style="background:#0ca30c"></i>目標 70-180</span>
    <span><i style="background:#fab219"></i>高 181-250</span>
    <span><i style="background:#ec835a"></i>很高 &gt;250</span>
    <span><i style="background:#d03b3b"></i>低 &lt;70</span>
    <span><i class="ring"></i>掃描</span>
    <span><i style="background:#8e2b6b"></i>速效注射（曲線上方）</span>
    <span><i class="diamond"></i>進食（曲線下方）</span>
  </div>

  <footer>
    曲線依血糖所屬分區上色。感測器斷線超過 30 分鐘的前後兩段<strong>不連線</strong>——
    直接連起來會描出一條實際不存在的平緩曲線。每小時欄位空白代表該小時沒有讀數，不是 0。
  </footer>
</div></details></div>
{% endif %}

{# ── P4 餐食 × 血糖：LibreView 做不到的部分。沒有飲食資料就整頁不輸出 ── #}
{% if responses %}
<div class="page flow"><details class="sect" open><summary><header>
    <div>
      <h1>餐食 × 血糖反應</h1>
      <div class="sub">每餐後 4 小時追蹤，疊合注射劑量與三大營養素</div>
    </div>
    <div class="sub tnum" style="text-align:right">
      可分析 {{ responses|length }} 餐<br>
      飲食紀錄自 {{ food_start }} 起
    </div>
  </header><span class="toggle" aria-hidden="true"></span></summary><div class="sect-body">

  {% if thin_warning %}
  <section><div class="thin">{{ thin_warning }}</div></section>
  {% endif %}

  <section class="meals">
    {% for r in responses %}
    <div class="card">
      <div class="when tnum">{{ r.meal.when.strftime('%m-%d %H:%M') }}　{{ r.meal.label or '未分類' }}</div>
      <div class="name">{{ r.meal.title }}</div>
      <div class="macros">
        <span>碳水 <b class="tnum">{{ '%.0f'|format(r.meal.carbs) }}g</b></span>
        <span>蛋白 <b class="tnum">{{ '%.0f'|format(r.meal.protein) }}g</b></span>
        <span>脂肪 <b class="tnum">{{ '%.0f'|format(r.meal.fat) }}g</b></span>
      </div>
      {{ r.svg|safe }}
      <div class="verdict">{{ r.verdict|safe }}</div>
    </div>
    {% endfor %}
  </section>

  <footer>
    餐前基準取進食前 20 分鐘內最後一筆讀數；峰值與到峰時間僅在餐後確實上升時標示。
    「前置注射」為進食前多久施打，負值代表餐後才施打。單筆餐次的反應同時受前一餐殘餘胰島素、
    活動量與壓力影響，<strong>單看一餐不足以推論因果</strong>。
  </footer>
</div></details></div>
{% endif %}

{# ── P3 資料品質與判讀限制 ──────────────────────────────────────────── #}
<div class="page"><details class="sect" open><summary><header>
    <div><h1>資料品質與判讀限制</h1></div>
  </header><span class="toggle" aria-hidden="true"></span></summary><div class="sect-body">

  <section>
    <h2>資料涵蓋</h2>
    <table>
      <tbody>
        <tr><td>分析期間</td><td class="n tnum">{{ m.start.strftime('%Y-%m-%d %H:%M') }} – {{ m.end.strftime('%Y-%m-%d %H:%M') }}</td></tr>
        <tr><td>血糖讀數（感測器歷史值）</td><td class="n tnum">{{ m.readings }} 筆</td></tr>
        <tr><td>感測器涵蓋率</td><td class="n tnum">{{ '%.1f'|format(m.coverage_pct) }}%{% if m.coverage_pct < 70 %}　<span class="miss">低於 AGP 建議的 70%</span>{% endif %}</td></tr>
        <tr><td>速效胰島素注射</td><td class="n tnum">{{ insulin_count }} 次・共 {{ '%.0f'|format(insulin_units) }} U</td></tr>
        <tr><td>可分析餐次</td><td class="n tnum">{{ responses|length }} 餐{% if skipped %}・{{ skipped }} 餐餐後血糖資料不足{% endif %}{% if drinks %}・{{ drinks }} 筆無熱量飲品不列入{% endif %}</td></tr>
      </tbody>
    </table>
  </section>

  <section class="rule">
    <h2>方法說明</h2>
    <table>
      <tbody>
        <tr><td>血糖軌跡來源</td><td>僅採感測器每 15 分鐘的歷史值。主動掃描值與歷史值在時間上重疊，若一併計入會重複計數並高估涵蓋率，故排除於所有指標之外。</td></tr>
        <tr><td>GMI 計算式</td><td class="tnum">3.31 + 0.02392 × 平均葡萄糖(mg/dL)</td></tr>
        <tr><td>百分位平滑</td><td>各時間格納入前後 45 分鐘讀數，避免短期間資料使曲線過度鋸齒。</td></tr>
        <tr><td>餐次合併</td><td>相隔 30 分鐘內的飲食紀錄視為同一次進食，否則同一頓飯會拆成多張卡片、重複計算同一個血糖峰值。</td></tr>
        <tr><td>低血糖事件</td><td>連續 15 分鐘以上低於 70 mg/dL 為一次事件。中間回升即分成兩次；感測器斷線超過 30 分鐘的前後兩段不併為同一次，避免貼片脫落捏造出橫跨數小時的假事件。跨日事件歸屬於起始日。</td></tr>
        <tr><td>長效胰島素</td><td>匯出檔中僅 95 筆紀錄、未逐日記錄（固定劑量施打），樣本不足以支撐任何分析，故<strong>不納入本報告</strong>。</td></tr>
        <tr><td>速效胰島素數值</td><td>反映的是<strong>記錄</strong>而非實際注射量。每日摘要中某日明顯偏低通常代表當天漏記，而非真的少打。</td></tr>
      </tbody>
    </table>
  </section>

  {# 靜態的一次性比對紀錄，不是本期間算出來的——日期必須寫死在句子裡，
     否則換一份 CSV 重跑，這段就會變成沒有根據的宣稱。 #}
  <section class="rule">
    <h2>與原廠報告的交叉驗證</h2>
    <p class="sub" style="margin:0 0 4px">
      2026-08-16 以同一份匯出檔比對 LibreView 官方 AGP 報告的 90 天輸出。
      期間相差一天（官方 05-19～08-16，本引擎 05-17～08-15），差異全數落在小數點層級。
    </p>
    <table>
      <thead><tr><th>指標</th><th class="n">LibreView</th><th class="n">本引擎</th><th class="n">差異</th></tr></thead>
      <tbody>
        <tr><td>平均葡萄糖</td><td class="n tnum">183</td><td class="n tnum">182</td><td class="n tnum muted">1</td></tr>
        <tr><td>GMI</td><td class="n tnum">7.7%</td><td class="n tnum">7.7%</td><td class="n tnum muted">0.0</td></tr>
        <tr><td>血糖變異度 CV</td><td class="n tnum">37.0%</td><td class="n tnum">36.6%</td><td class="n tnum muted">0.4</td></tr>
        <tr><td>目標範圍內時間</td><td class="n tnum">52%</td><td class="n tnum">50.5%</td><td class="n tnum muted">1.5</td></tr>
        <tr><td>很高 &gt;250</td><td class="n tnum">14%</td><td class="n tnum">14.3%</td><td class="n tnum muted">0.3</td></tr>
      </tbody>
    </table>
  </section>

  <section class="rule">
    <h2>色彩無障礙聲明</h2>
    <p class="sub" style="margin:0 0 6px">
      本報告第 1 頁沿用 LibreView、Dexcom 等臨床報告通用的紅／綠／黃／橙分區配色，
      以保留醫師的判讀習慣。此配色在色覺辨識困難下並不安全——經模擬計算，
      低血糖紅與目標綠在綠色弱（deutan）條件下的色差僅 <span class="tnum">ΔE 4.1</span>，
      遠低於可區辨門檻 <span class="tnum">6.0</span>。因此本報告一律搭配下列補償，任何顏色都不單獨承載訊息：
    </p>
    <table>
      <tbody>
        <tr><td>固定排序</td><td>分區永遠由高到低排列，不因數值大小重新排序。</td></tr>
        <tr><td>直接數值標籤</td><td>堆疊條每一段都標出百分比，過薄的分段以引線標示於外側。</td></tr>
        <tr><td>等價表格檢視</td><td>第 1 頁的分區表格與堆疊條內容完全等價，可單獨判讀。</td></tr>
        <tr><td>文字範圍標示</td><td>每個分區都附上 mg/dL 數值範圍，不倚賴顏色辨識。</td></tr>
      </tbody>
    </table>
    <p class="sub" style="margin:6px 0 0">
      第 2 頁以後的個人洞察圖表改用經無障礙驗證的配色（全配對色差通過綠色弱與紅色弱模擬）。
    </p>
  </section>

  <footer>
    產生時間 {{ generated }}・分析引擎 agp_report<br>
    本報告不構成醫療建議。所有劑量調整請與您的醫療團隊討論。
  </footer>
</div></details></div>

{# ── 互動：滑過曲線顯示該時刻的數值 ─────────────────────────────────────
   專案原本的決定是「不用 JS 圖表庫（離線與列印不可靠）」——反對的是外部
   相依，不是所有 JS。這段內嵌原生程式碼不破壞自包含、不需要網路，
   而且沒有它時整份報告就是改動前的靜態 SVG。 #}
<script type="application/json" id="xh-data">{{ xh_data|safe }}</script>
<script>
(function () {
  var el = document.getElementById("xh-data");
  if (!el || !document.querySelector(".xh")) return;
  var DATA = JSON.parse(el.textContent);

  var pad = function (n) { return n < 10 ? "0" + n : "" + n; };
  var hhmm = function (min) { return pad(Math.floor(min / 60)) + ":" + pad(min % 60); };
  var colour = function (v) {
    return v < 54 ? "#8b1a1a" : v < 70 ? "#d03b3b"
         : v < 180 ? "#0ca30c" : v < 250 ? "#fab219" : "#ec835a";
  };

  // 使用者自己列印時，折疊起來的區段不能就這樣消失在紙本上。
  // 下載 PDF 走的是伺服器端轉檔，那份儲存檔永遠是 open，不受這裡影響。
  window.addEventListener("beforeprint", function () {
    Array.prototype.forEach.call(document.querySelectorAll("details.sect"), function (d) {
      if (!d.open) { d.dataset.reopen = "1"; d.open = true; }
    });
  });
  window.addEventListener("afterprint", function () {
    Array.prototype.forEach.call(document.querySelectorAll("details.sect"), function (d) {
      if (d.dataset.reopen) { d.open = false; delete d.dataset.reopen; }
    });
  });

  Array.prototype.forEach.call(document.querySelectorAll("svg.xh"), function (svg) {
    var kind = svg.dataset.xh;
    var x0 = +svg.dataset.x0, x1 = +svg.dataset.x1;
    var top = +svg.dataset.top, ph = +svg.dataset.ph;
    var ymin = +svg.dataset.ymin, ymax = +svg.dataset.ymax;
    var vb = svg.viewBox.baseVal.width;

    var day = kind === "day" ? DATA.day[+svg.dataset.i] : null;
    if (kind === "day" && !day) return;
    var n = kind === "day" ? day.slots.length : DATA.agp.length;

    var cross = svg.querySelector(".xh-cross");
    var dot = svg.querySelector(".xh-dot");
    var hit = svg.querySelector(".xh-hit");
    if (!cross || !dot || !hit) return;

    var tip = document.createElement("div");
    tip.className = "xh-tip";
    svg.parentNode.appendChild(tip);

    var Y = function (v) {
      var c = Math.max(ymin, Math.min(ymax, v));
      return top + ph * (ymax - c) / (ymax - ymin);
    };
    var X = function (i) { return x0 + (x1 - x0) * i / (n - 1); };

    var hide = function () {
      tip.style.opacity = "0";
      cross.setAttribute("opacity", "0");
      dot.setAttribute("opacity", "0");
    };

    var show = function (clientX) {
      var r = svg.getBoundingClientRect();
      if (!r.width) return;
      var scale = vb / r.width;                       // viewBox 單位 ÷ 螢幕像素
      var i = Math.round(((clientX - r.left) * scale - x0) / (x1 - x0) * (n - 1));
      i = Math.max(0, Math.min(n - 1, i));

      var value, html;
      if (kind === "day") {
        value = day.slots[i];
        if (value === null) { hide(); return; }       // 該格沒有讀數
        var minute = i * 15;
        var near = day.ins.filter(function (p) { return Math.abs(p[0] - minute) <= 15; });
        html = hhmm(minute) + "　<b>" + value + "</b> mg/dL";
        if (near.length) {
          html += '<br><span class="ev">速效 ' + near.map(function (p) {
            return p[1].toFixed(1) + "u";
          }).join("、") + "</span>";
        }
        (day.meal || []).filter(function (mm) {
          return Math.abs(mm[0] - minute) <= 15;
        }).forEach(function (mm) {
          html += "<br>" + mm[1] + "　" + mm[2]
                + '<br><span class="ev">碳水 ' + mm[3] + "g・蛋白 " + mm[4]
                + "g・脂肪 " + mm[5] + "g</span>";
        });
      } else {
        var row = DATA.agp[i];
        value = row[2];
        html = hhmm(i * 15) + "　中位數 <b>" + value + "</b>"
             + "<br>5–95%：" + row[0] + "–" + row[4]
             + '　<span class="ev">25–75%：' + row[1] + "–" + row[3] + "</span>"
             + '<br><span class="ev">該時間格 ' + row[5] + " 筆讀數</span>";
      }

      cross.setAttribute("x1", X(i)); cross.setAttribute("x2", X(i));
      cross.setAttribute("opacity", "0.35");
      dot.setAttribute("cx", X(i)); dot.setAttribute("cy", Y(value));
      dot.setAttribute("fill", colour(value));
      dot.setAttribute("opacity", "1");

      tip.innerHTML = html;
      var left = X(i) / scale + 8;
      tip.style.left = Math.max(0, Math.min(r.width - tip.offsetWidth - 2, left)) + "px";
      tip.style.top = (svg.offsetTop + Y(value) / scale - tip.offsetHeight - 6) + "px";
      tip.style.opacity = "1";
    };

    svg.addEventListener("mousemove", function (e) { show(e.clientX); });
    svg.addEventListener("mouseleave", hide);
    // 觸控裝置沒有 hover。preventDefault 讓橫向拖曳不被頁面捲動搶走。
    svg.addEventListener("touchstart", function (e) {
      e.preventDefault(); show(e.touches[0].clientX);
    }, { passive: false });
    svg.addEventListener("touchmove", function (e) {
      e.preventDefault(); show(e.touches[0].clientX);
    }, { passive: false });
    svg.addEventListener("touchend", hide);
  });
})();
</script>

</body>
</html>
